{
  "manifest_version": 3,
  "name": "Group Tags",
  "version": "0.0.0",
  "description": "Tag tab groups with your categories.",
  "permissions": ["tabs", "storage"],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Group Tags",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup/index.html"
  },
  "commands": {
    "cycle-category": {
      "suggested_key": {
        "default": "Alt+T",
        "mac": "Command+Shift+T"
      },
      "description": "Apply the next tag to the active tab group"
    }
  },
  "options_ui": {
    "page": "settings/index.html",
    "open_in_tab": true
  }
}
