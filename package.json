{
  "name": "tabgroup-marker",
  "version": "1.0.0",
  "description": "TabGroup Marker is a lightweight browser extension that lets you effortlessly label and organize tab groups with custom categories.",
  "private": true,
  "type": "module",
  "scripts": {
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build": "run-s build:chrome build:firefox",
    "dev:chrome": "vite build --mode development-chrome --watch",
    "dev:firefox": "vite build --mode development-firefox --watch",
    "dev": "run-p dev:chrome dev:firefox",
    "start:firefox": "web-ext run --source-dir dist/firefox",
    "package:chrome": "run-s build:chrome \"zip chrome\"",
    "package:firefox": "run-s build:firefox \"zip firefox\"",
    "package:sources": "tsx scripts/package.ts sources",
    "package": "run-s package:chrome package:firefox package:sources",
    "zip": "tsx scripts/package.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist artifacts"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/webextension-polyfill": "^0.12.6",
    "adm-zip": "^0.6.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "npm-run-all2": "^9.0.3",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "web-ext": "^10.7.0"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  },
  "allowScripts": {
    "esbuild": false
  }
}
