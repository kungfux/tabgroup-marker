{
  "name": "tab-groups-organizer",
  "version": "0.1.0",
  "description": "Browser extension for organizing tab groups",
  "private": true,
  "type": "module",
  "scripts": {
    "build:chrome": "vite build --mode chrome",
    "build:firefox": "vite build --mode firefox",
    "build": "run-s build:chrome build:firefox",
    "dev:chrome": "vite build --mode development-chrome --watch",
    "dev:firefox": "vite build --mode development-firefox --watch",
    "dev": "run-p dev:chrome dev:firefox",
    "start:firefox": "web-ext run --source-dir dist/firefox",
    "package:chrome": "run-s build:chrome \"zip chrome\"",
    "package:firefox": "run-s build:firefox \"zip firefox\"",
    "package:sources": "tsx scripts/package.ts sources",
    "package": "run-s package:chrome package:firefox package:sources",
    "zip": "tsx scripts/package.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist artifacts"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/adm-zip": "^0.5.7",
    "@types/chrome": "^0.0.304",
    "@types/node": "^22.10.0",
    "@types/webextension-polyfill": "^0.12.1",
    "adm-zip": "^0.5.16",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.0.0",
    "npm-run-all2": "^7.0.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.19.0",
    "vite": "^6.0.0",
    "web-ext": "^8.3.0"
  }
}
